{
  "info": {
    "name": "Usuarios API (laboratorio)",
    "description": "Colección complementaria a la suite Karate: muestra variables de entorno, scripts previos, encadenamiento de solicitudes y pruebas en Postman. Todos los valores son ficticios y de laboratorio. Ejecutar con Newman (ver README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Prueba común a todas las solicitudes de la colección",
          "pm.test('Responde en menos de ' + pm.environment.get('maxResponseTimeMs') + ' ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseTimeMs')));",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "esquemaUsuario",
      "value": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"nombre\",\"email\",\"rol\",\"activo\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"nombre\":{\"type\":\"string\"},\"email\":{\"type\":\"string\",\"pattern\":\"^[^@\\\\s]+@[^@\\\\s]+\\\\.[^@\\\\s]+$\"},\"rol\":{\"enum\":[\"admin\",\"supervisor\",\"usuario\"]},\"activo\":{\"type\":\"boolean\"}}}"
    },
    {
      "key": "saldoOrigenAntes",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Preparación",
      "item": [
        {
          "name": "Restablecer datos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Datos restablecidos', function () { pm.expect(pm.response.json().status).to.eql('restablecido'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/test/reset"
          }
        },
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "pm.test('Servicio disponible', function () { pm.expect(pm.response.json()).to.eql({ status: 'ok' }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "02 Autenticación",
      "item": [
        {
          "name": "Login correcto (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Entrega un token Bearer', function () {",
                  "    pm.expect(cuerpo.token_type).to.eql('Bearer');",
                  "    pm.expect(cuerpo.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "// Encadenamiento: las solicitudes siguientes usan {{token}}",
                  "pm.environment.set('token', cuerpo.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Recurso seguro con token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const esquema = JSON.parse(pm.collectionVariables.get('esquemaUsuario'));",
                  "pm.test('Cada usuario cumple el esquema', function () {",
                  "    pm.response.json().forEach(function (usuario) { pm.expect(usuario).to.be.jsonSchema(esquema); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/secure/usuarios"
          }
        },
        {
          "name": "Recurso seguro sin token responde 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Incluye WWW-Authenticate: Bearer', function () { pm.response.to.have.header('WWW-Authenticate', 'Bearer'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/secure/usuarios"
          }
        },
        {
          "name": "API Key válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve los usuarios', function () { pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/apikey/usuarios"
          }
        }
      ]
    },
    {
      "name": "03 CRUD encadenado",
      "item": [
        {
          "name": "Crear usuario (email único y guarda el id)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Script previo: genera un email único para no depender de datos fijos",
                  "pm.variables.set('emailUnico', 'qa.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const usuario = pm.response.json();",
                  "pm.test('Cumple el esquema', function () { pm.expect(usuario).to.be.jsonSchema(JSON.parse(pm.collectionVariables.get('esquemaUsuario'))); });",
                  "pm.test('Guarda el email enviado', function () { pm.expect(usuario.email).to.eql(pm.variables.get('emailUnico')); });",
                  "pm.collectionVariables.set('usuarioId', usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"email\": \"{{emailUnico}}\",\n  \"rol\": \"usuario\",\n  \"activo\": true\n}"
            },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Obtener el usuario creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Es el usuario creado', function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('usuarioId'))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Actualizar parcialmente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Cambia solo activo', function () {",
                  "    pm.expect(pm.response.json().activo).to.eql(false);",
                  "    pm.expect(pm.response.json().nombre).to.eql('Usuario Postman');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"activo\": false }"
            },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Eliminar el usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 sin cuerpo', function () {",
                  "    pm.response.to.have.status(204);",
                  "    pm.expect(pm.response.text()).to.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "El usuario eliminado responde 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Mensaje con el id', function () {",
                  "    pm.expect(pm.response.json().mensaje).to.eql('El usuario ' + pm.collectionVariables.get('usuarioId') + ' no existe.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          }
        }
      ]
    },
    {
      "name": "04 SOAP",
      "item": [
        {
          "name": "ObtenerUsuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type text/xml', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('text/xml'); });",
                  "// xml2js con explicitArray: false convierte cada elemento en propiedad (o texto) en vez de lista",
                  "let xml;",
                  "require('xml2js').parseString(pm.response.text(), { explicitArray: false }, function (error, resultado) { xml = resultado; });",
                  "const usuario = xml['soapenv:Envelope']['soapenv:Body']['usu:ObtenerUsuarioResponse']['usu:usuario'];",
                  "pm.test('Devuelve el usuario 2', function () {",
                  "    pm.expect(usuario['usu:id']).to.eql('2');",
                  "    pm.expect(usuario['usu:nombre']).to.eql('Bruno Díaz');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "http://poc.qa/usuarios/ObtenerUsuario"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:usu=\"http://poc.qa/usuarios\">\n  <soapenv:Body>\n    <usu:ObtenerUsuario>\n      <usu:id>2</usu:id>\n    </usu:ObtenerUsuario>\n  </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": "{{baseUrl}}/soap/usuarios"
          }
        },
        {
          "name": "ObtenerUsuario inexistente responde SOAP Fault",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 500', function () { pm.response.to.have.status(500); });",
                  "// xml2js con explicitArray: false convierte cada elemento en propiedad (o texto) en vez de lista",
                  "let xml;",
                  "require('xml2js').parseString(pm.response.text(), { explicitArray: false }, function (error, resultado) { xml = resultado; });",
                  "const fault = xml['soapenv:Envelope']['soapenv:Body']['soapenv:Fault'];",
                  "pm.test('SOAP Fault de cliente', function () {",
                  "    pm.expect(fault.faultcode).to.eql('soapenv:Client');",
                  "    pm.expect(fault.faultstring).to.eql('El usuario 999 no existe.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "http://poc.qa/usuarios/ObtenerUsuario"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:usu=\"http://poc.qa/usuarios\">\n  <soapenv:Body>\n    <usu:ObtenerUsuario>\n      <usu:id>999</usu:id>\n    </usu:ObtenerUsuario>\n  </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": "{{baseUrl}}/soap/usuarios"
          }
        }
      ]
    },
    {
      "name": "05 Errores",
      "item": [
        {
          "name": "503 con Retry-After",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 503', function () { pm.response.to.have.status(503); });",
                  "pm.test('Retry-After: 30', function () { pm.response.to.have.header('Retry-After', '30'); });",
                  "pm.test('Cuerpo de error', function () { pm.expect(pm.response.json()).to.include({ codigo: 503, error: 'Service Unavailable' }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/errores/503"
          }
        }
      ]
    },
    {
      "name": "06 Banca",
      "item": [
        {
          "name": "Saldo de la cuenta de origen (lo guarda)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const cuenta = pm.response.json();",
                  "pm.test('Cuenta activa', function () { pm.expect(cuenta.estado).to.eql('activa'); });",
                  "// Encadenamiento: la transferencia siguiente compara contra este saldo",
                  "pm.collectionVariables.set('saldoOrigenAntes', cuenta.saldo);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/cuentas/10"
          }
        },
        {
          "name": "Transferencia válida (descuenta el monto exacto)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Monto fijo con centavos, para verificar el redondeo",
                  "pm.variables.set('monto', 12.34);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const t = pm.response.json();",
                  "const antes = Number(pm.collectionVariables.get('saldoOrigenAntes'));",
                  "const esperado = Math.round((antes - 12.34) * 100) / 100;",
                  "pm.test('Descuenta el monto de la cuenta de origen', function () { pm.expect(t.saldoOrigen).to.eql(esperado); });",
                  "pm.test('Estado completada', function () { pm.expect(t.estado).to.eql('completada'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuentaOrigen\": 10,\n  \"cuentaDestino\": 20,\n  \"monto\": {{monto}}\n}"
            },
            "url": "{{baseUrl}}/api/transferencias"
          }
        },
        {
          "name": "Saldo insuficiente responde 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('Informa el saldo insuficiente', function () { pm.expect(pm.response.json().mensaje).to.include('Saldo insuficiente en la cuenta 20'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuentaOrigen\": 20,\n  \"cuentaDestino\": 10,\n  \"monto\": 999999\n}"
            },
            "url": "{{baseUrl}}/api/transferencias"
          }
        }
      ]
    }
  ]
}
