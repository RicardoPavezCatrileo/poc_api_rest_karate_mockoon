<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>poc.api</groupId>
    <artifactId>poc_api_rest_karate_mockoon</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>POC API REST con Karate DSL y Mockoon</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Última versión de karate-junit5 en Maven Central; Karate 2.x solo publica karate-junit6 -->
        <karate.version>1.5.2</karate.version>
        <!-- Valida respuestas contra OpenAPI; no es un cliente HTTP (las solicitudes las hace Karate) -->
        <openapi-validator.version>3.0.0</openapi-validator.version>
        <h2.version>2.5.252</h2.version>
        <!-- Mismas versiones que karate-parent 1.5.2 usa con karate-gatling (Gatling 3.11.5) -->
        <gatling-maven-plugin.version>4.3.4</gatling-maven-plugin.version>
        <!-- Simulación y perfil por defecto de .\mvnw.cmd test-compile gatling:test -->
        <simulacion>performance.UsuariosSimulation</simulacion>
        <perfil>carga</perfil>
        <!-- Gatling corre en otra JVM: estos valores se le pasan explícitamente -->
        <baseUrl>http://localhost:3001</baseUrl>
        <karate.env>local</karate.env>
        <!-- Monitor de recursos (MonitorRecursos): vacío = busca el PID del mock por el puerto de baseUrl -->
        <mockPid></mockPid>
        <monitor.intervaloMs>1000</monitor.intervaloMs>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>openapi-request-validator-core</artifactId>
            <version>${openapi-validator.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Base de datos embebida (modo PostgreSQL) para preparar y validar datos con SQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-gatling</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Los .feature, karate-config.js y logback-test.xml viven junto al código Java -->
        <testResources>
            <testResource>
                <directory>src/test/java</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </testResource>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Un solo punto de entrada: el runner decide qué features se ejecutan -->
                    <includes>
                        <include>ApiTestRunner.java</include>
                    </includes>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
                <configuration>
                    <simulationClass>${simulacion}</simulationClass>
                    <jvmArgs>
                        <jvmArg>-Dfile.encoding=UTF-8</jvmArg>
                        <jvmArg>-Dperfil=${perfil}</jvmArg>
                        <jvmArg>-DbaseUrl=${baseUrl}</jvmArg>
                        <jvmArg>-Dkarate.env=${karate.env}</jvmArg>
                        <jvmArg>-DmockPid=${mockPid}</jvmArg>
                        <jvmArg>-Dmonitor.intervaloMs=${monitor.intervaloMs}</jvmArg>
                        <!-- Bajo carga, el log DEBUG de cada solicitud distorsiona los tiempos -->
                        <jvmArg>-Dkarate.log.level=WARN</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
