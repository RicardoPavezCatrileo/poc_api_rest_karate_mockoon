{
  "name": "usuario-existente",
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/usuarios/[1-3]"
  },
  "response": {
    "headers": {
      "Content-Type": "application/json"
    },
    "status": 200,
    "bodyFileName": "usuario-{{request.pathSegments.[2]}}.json",
    "transformers": [
      "response-template"
    ]
  }
}
